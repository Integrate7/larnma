# E2E test environment — dummy values, safe to commit.
# Override any var by exporting it in your shell before running `npm run test:e2e`.

# Required: signs/verifies JWTs issued by the auth/OTP flow. Must be ≥32 chars for HS256.
JWT_SECRET=larnma-e2e-dummy-jwt-secret-do-not-use-in-prod

# OAuth placeholders — not hit by current specs, set so any accidental call doesn't crash.
GOOGLE_CLIENT_ID=e2e-dummy-client-id
GOOGLE_CLIENT_SECRET=e2e-dummy-client-secret
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Leave GEMINI_API_KEY unset so the Gemini service falls back to MockGeminiAdapter.
